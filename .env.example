# ==========================================
# ReviewReward - Micro-Task Platform Environment Config
# ==========================================

# 1. Database (Supabase PostgreSQL)
# Example: postgresql://postgres.[YOUR-PROJECT]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:your-supabase-db-password@db.your-project.supabase.co:5432/postgres"

# Optional: Direct connection for migrations if using PgBouncer
DIRECT_URL="postgresql://postgres:your-supabase-db-password@db.your-project.supabase.co:5432/postgres"

# 2. Supabase API Keys (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 3. Authentication (NextAuth.js with Google OAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="reviewreward-super-secret-key-production-32chars"

# Google Cloud Console OAuth 2.0 Credentials:
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin Google Emails (comma-separated - auto-promoted to ADMIN role on Google login)
ADMIN_EMAILS="admin@gmail.com,admin@reviewreward.local"

# 4. NOWPayments Mass Payouts API (USDT on Polygon Network)
# Use https://api.sandbox.nowpayments.io/v1 for testing, https://api.nowpayments.io/v1 for production
NOWPAYMENTS_API_URL="https://api.nowpayments.io/v1"
NOWPAYMENTS_API_KEY="your-nowpayments-api-key"
NOWPAYMENTS_EMAIL="your-nowpayments-account@email.com"
NOWPAYMENTS_PASSWORD="your-nowpayments-account-password"

# NOWPayments 2FA Secret (Base32 TOTP secret from your Authenticator app for hands-free 100% automated payouts)
NOWPAYMENTS_2FA_SECRET="JBSWY3DPEHPK3PXP"

# NOWPayments IPN Secret (for verifying HMAC-SHA512 webhook signature on payout status updates)
NOWPAYMENTS_IPN_SECRET="your-nowpayments-ipn-secret"
