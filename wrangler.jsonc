{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earnjavnex",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "earnjavnex"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "758717407504-589te6v2b5gc0mgodjrnacpg6romi2ku.apps.googleusercontent.com"
  },
  "observability": {
    "enabled": true
  }
}
